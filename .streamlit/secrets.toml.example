# Copy this file to secrets.toml and replace all placeholder values.
# On Streamlit Community Cloud, add these values under App settings > Secrets.
# Share only APP_USERNAME and APP_PASSWORD with approved users.
APP_USERNAME = "your-shared-user-id"
APP_PASSWORD = "replace-with-a-long-unique-password"

# Claude (Opus 4.6) is served from Azure via the Anthropic Messages protocol.
AZURE_OPENAI_KEY = "your-azure-openai-key-here"
